# ===== Chung =====
NODE_ENV=development
API_PORT=4000
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
TRUST_PROXY_HOPS=0
DB_POOL_MAX=5

# ===== Database =====
# Hai Supabase project RIÊNG: DATABASE_URL cho dev/demo; DATABASE_URL_TEST chỉ cho test.
# Lấy URL trong Supabase Dashboard > Connect. Thay các giá trị mẫu bằng thông tin thật.
# Direct connection (port 5432):
DATABASE_URL=postgresql://postgres:<dev-password>@db.<dev-project-ref>.supabase.co:5432/postgres
DATABASE_URL_TEST=postgresql://postgres:<test-password>@db.<test-project-ref>.supabase.co:5432/postgres
# Session pooler (port 5432), nếu máy/mạng không truy cập được host Direct:
# DATABASE_URL=postgresql://postgres.<dev-project-ref>:<password>@<dev-session-pooler-host>:5432/postgres
# DATABASE_URL_TEST=postgresql://postgres.<test-project-ref>:<password>@<test-session-pooler-host>:5432/postgres
# KHÔNG dùng Transaction pooler (port 6543) cho API hoặc migration.
# Test và migrate:test từ chối chạy trừ khi ALLOW_DESTRUCTIVE_TESTS="true".
ALLOW_DESTRUCTIVE_TESTS=false

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=workshop_session
COOKIE_SECURE=false

# ===== Admin seed =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# ===== Đặt chỗ =====
HOLD_MINUTES=15
MAX_TICKETS_PER_BOOKING=10
EXPIRY_JOB_INTERVAL_SECONDS=60

# ===== Thanh toán =====
PAYMENT_PROVIDER=mock            # mock | payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/return
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
# URL công khai để PayOS gọi webhook (dùng tunnel khi chạy local)
PAYOS_WEBHOOK_URL=
# Khóa dùng riêng cho test ký webhook giả (không phải khóa thật)
PAYOS_CHECKSUM_KEY_TEST=test-checksum-key

# ===== Dịch vụ xếp hạng =====
RANKER_URL=http://localhost:8001
RANKER_TIMEOUT_MS=1500

# ===== Tùy chọn (mức 3) =====
GEMINI_API_KEY=
