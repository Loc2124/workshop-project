# ====================================================================
# Open Slot - Cấu hình môi trường Production (Render API + Vercel Web)
# ====================================================================

# ===== Chung =====
NODE_ENV=production
PORT=4000
API_PORT=4000
WEB_ORIGIN=https://www.openslot.io.vn
CLIENT_URL=https://www.openslot.io.vn
VITE_API_BASE_URL=/api
VITE_DATA_MODE=api
VITE_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
TRUST_PROXY_HOPS=1
DB_POOL_MAX=5

# ===== Database Production =====
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
ALLOW_DESTRUCTIVE_TESTS=false

# ===== Supabase Storage Production =====
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
STUDIO_IMAGE_BUCKET=studio-images

# ===== Auth Production (HTTPS + Reverse Proxy) =====
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_BASE64URL_SECRET_AT_LEAST_43_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=14d
COOKIE_NAME=workshop_session
REFRESH_COOKIE_NAME=workshop_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
AUTH_COOKIE_PATH_PREFIX=/api

# ===== Admin seed =====
SEED_ADMIN_EMAIL=admin@openslot.io.vn
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ===== Đặt chỗ =====
HOLD_MINUTES=15
MAX_TICKETS_PER_BOOKING=10
EXPIRY_JOB_INTERVAL_SECONDS=60

# ===== Thanh toán PayOS Production =====
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=REPLACE_WITH_PAYOS_CLIENT_ID
PAYOS_API_KEY=REPLACE_WITH_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=REPLACE_WITH_PAYOS_CHECKSUM_KEY
PAYOS_RETURN_URL=https://www.openslot.io.vn/payment/return
PAYOS_CANCEL_URL=https://www.openslot.io.vn/payment/cancel
PAYOS_WEBHOOK_URL=https://api.openslot.io.vn/webhooks/payos
PAYMENT_MIN_AMOUNT=1000

# ===== Chi hộ PayOS Production =====
PAYOUT_PROVIDER=payos
PAYOS_PAYOUT_CLIENT_ID=REPLACE_WITH_PAYOS_PAYOUT_CLIENT_ID
PAYOS_PAYOUT_API_KEY=REPLACE_WITH_PAYOS_PAYOUT_API_KEY
PAYOS_PAYOUT_CHECKSUM_KEY=REPLACE_WITH_PAYOS_PAYOUT_CHECKSUM_KEY

# ===== Email & Webhooks Production =====
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM="Open Slot <noreply@mail.openslot.io.vn>"
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SECRET

# ===== Dịch vụ xếp hạng =====
RANKER_URL=http://localhost:8001
RANKER_TIMEOUT_MS=1500

# ===== Mã hóa tài khoản thanh toán =====
FINANCIAL_ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
